# Для строк вида VARIABLE=dev:"value" or prod:"value" выберите одно значение.
# В рабочем .env оставьте VARIABLE="value" без dev:, prod: и or.
# Для локального запуска и бенчмарка выбирайте dev, для prod-контейнера — prod.
# Остальные значения общие; замените примеры секретов и настройки LLM своими.

APP_HOST=dev:"localhost" or prod:"0.0.0.0"
APP_PORT=8080
APP_OUTPUT_PORT=8080
APP_LOGGER_LEVEL="info"
APP_PASSWORD_SALT="saltexample"
APP_EMBEDDING_SIZE=100
APP_STATISTICS_BATCH_SIZE=20

BOOKS_DIR=dev:"./data/student_book_pdf" or prod:"/app/data/student_book_pdf"
BOOKS_EXT=".pdf"

LLM_URL="llm.example.url"
LLM_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
LLM_REQUEST_TIMEOUT=12
LLM_API_KEY="api-key"

JWT_SECRET="jwtsecretexample"
JWT_ACCESS_EXP=5
JWT_REFRESH_EXP=1440

POSTGRES_HOST=dev:"localhost" or prod:"database"
POSTGRES_PORT=5432
POSTGRES_OUTPUT_PORT=5432
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="rag_search"

REDIS_HOST=dev:"localhost" or prod:"redis_db"
REDIS_PORT=6379
REDIS_OUTPUT_PORT=6379
REDIS_DB=0

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_USER="user"
GF_SECURITY_ADMIN_PASSWORD="password"

CLICKHOUSE_HOST=dev:"localhost" or prod:"clickhouse"
CLICKHOUSE_PORT=dev:"9000" or prod:"8123"
CLICKHOUSE_OUTPUT_PORT=dev:"8123" or prod:"9000"
CLICKHOUSE_USER="user"
CLICKHOUSE_PASSWORD="password"
CLICKHOUSE_DB="rag_manual_searcher"

# Используются prod Compose для подключения PDF и настройки ClickHouse.
BOOKS_SOURCE_DIR="../../data/student_book_pdf"
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# Этапы подготовки prod-контейнера: true/1 — выполнять, false/0 — пропустить.
RUN_POSTGRES_MIGRATIONS=true
RUN_CLICKHOUSE_MIGRATIONS=true
RUN_DATA_MIGRATION=true
